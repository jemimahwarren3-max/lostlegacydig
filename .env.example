# Copy this file to .env.local and fill in once you have accounts set up.
# The app runs fine with none of these set — checkout falls back to test
# mode and the admin passcode falls back to the default below.

# From paynow.co.zw once your merchant account is approved
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://your-deployed-url.example/api/checkout/result
PAYNOW_RETURN_URL=https://your-deployed-url.example/thank-you

# Passcode for the /admin verification queue. Change this before any real pilot.
ADMIN_PASSCODE=lostlegacy2026
